# Static files for the browser: map tiles (PMTiles), scores.parquet and manifest.json.
# PMTiles is read with HTTP range requests, which file_server supports. Only JSON is
# compressed: PMTiles and Parquet are compressed internally, and compressing a byte
# range breaks the client's offsets.
:8080 {
	root * /srv
	@json path *.json
	encode @json zstd gzip
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Headers Range
		Access-Control-Expose-Headers "Content-Length, Content-Range, ETag"
		# Revalidate (ETag) every time: PMTiles and Parquet are read in byte ranges, and a
		# stale range from a previous build would corrupt the read
		Cache-Control "no-cache"
	}
	file_server
}
