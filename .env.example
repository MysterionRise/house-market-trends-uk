# Copy to .env and fill in what you use. Only one model provider is needed.

# Which model drives the assistant (provider:model). "test" runs a scripted assistant
# that needs no key. Examples: anthropic:claude-opus-5-5, openai:gpt-5,
# google:gemini-2.5-pro, ollama:llama3.1
LIX_MODEL=anthropic:claude-opus-5-5
# Optional comma-separated fallbacks tried if the first model fails
# LIX_FALLBACK_MODELS=openai:gpt-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Reasoning effort for Anthropic models (low is plenty for picking tools)
# LIX_EFFORT=low

# Keep data on another disk (defaults to ./data)
# LIX_DATA_DIR=/Volumes/data/lix
