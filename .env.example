# Copy to .env and fill in what you use. Only one model provider is needed.

# Which model drives the assistant (provider:model). "test" runs a scripted assistant
# that needs no key. With an OpenRouter key, one key reaches many providers:
#   openrouter:anthropic/claude-opus-5.5, openrouter:anthropic/claude-haiku-4.5, ...
# Direct providers: anthropic:claude-opus-5-5, openai:gpt-5, google:gemini-2.5-pro,
# ollama:llama3.1
LIX_MODEL=openrouter:anthropic/claude-opus-5.5
# Optional comma-separated fallbacks tried if the first model fails
# LIX_FALLBACK_MODELS=openrouter:anthropic/claude-haiku-4.5

OPENROUTER_API_KEY=
# OPENROUTER_APP_TITLE=UK Liveability Index
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Reasoning effort (low is plenty for picking tools)
# LIX_EFFORT=low

# Per-question limits (the assistant stops politely when it hits one)
# LIX_REQUEST_LIMIT=8
# LIX_TOOL_CALL_LIMIT=12
# LIX_TOKEN_LIMIT=150000
# LIX_COST_LIMIT=0.50        # in the provider's currency; OpenRouter reports cost
# LIX_MODEL_TIMEOUT=60       # seconds per model request

# Keep data on another disk (defaults to ./data)
# LIX_DATA_DIR=/Volumes/data/lix
